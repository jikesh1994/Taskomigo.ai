# Copy to .env and fill in. NEVER commit .env or real secrets.
# docker compose reads this file automatically; the backend also reads backend/.env
# when run outside Docker.

# --- Application -----------------------------------------------------------
ENVIRONMENT=local                # local | test | staging | production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# --- Database / Redis ------------------------------------------------------
# Inside docker compose these are derived automatically. Set them when running
# the API directly on your machine.
DATABASE_URL=postgresql+asyncpg://jobagent:jobagent@localhost:5433/jobagent
REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=jobagent
POSTGRES_PASSWORD=jobagent
POSTGRES_DB=jobagent

# --- Security (required in staging/production; min 32 random chars, all different) ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET=
# Comma-separated Fernet keys; the first encrypts, all decrypt (rotation).
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEYS=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
# Failed sign-ins per account (from any IP) before that account is paused for the window.
LOGIN_MAX_FAILURES_PER_ACCOUNT=10
LOGIN_FAILURE_WINDOW_SECONDS=900

# --- Web -------------------------------------------------------------------
# The browser calls the API directly. FRONTEND_URL and PUBLIC_API_URL must be
# same-site (e.g. app.example.com + api.example.com) so the SameSite=Strict
# refresh cookie is sent. PUBLIC_API_URL is baked into the frontend build.
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=

# --- AI --------------------------------------------------------------------
# Resume parsing needs a model. With "none", uploads still work but each resume is
# marked "couldn't read: AI isn't set up" and can be parsed again once configured.
#   anthropic: LLM_API_KEY=sk-ant-...           (default model claude-opus-5-5)
#   openai:    LLM_API_KEY=sk-..., LLM_MODEL=<model id>
#   local:     LLM_BASE_URL=http://host:11434/v1, LLM_MODEL=<model> (OpenAI-compatible)
LLM_PROVIDER=none                # none | anthropic | openai | local
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=120

# --- Object storage --------------------------------------------------------
# Every file is encrypted with ENCRYPTION_KEYS before it reaches the backend.
STORAGE_BACKEND=local            # local | gcs | s3
STORAGE_LOCAL_PATH=./data/uploads
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=              # GCS: an HMAC access key (S3-compatible API)
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT_URL=            # optional; GCS defaults to https://storage.googleapis.com
STORAGE_REGION=

# --- Resumes ---------------------------------------------------------------
RESUME_MAX_BYTES=5242880
RESUME_MAX_PER_USER=10
RESUME_MAX_PAGES=20
RESUME_PARSE_INLINE=false        # true = parse inside the API (no worker; dev/tests only)

# ---- Job search (public Greenhouse / Lever job-board APIs; no credentials needed) ----
JOB_TASKS_INLINE=false           # true = run searches and AI job analysis inside the API
JOB_FETCH_TIMEOUT_SECONDS=20
JOB_FETCH_CONCURRENCY=4          # boards fetched at once per search
JOB_MAX_SOURCES_PER_USER=50
# GREENHOUSE_API_BASE=https://boards-api.greenhouse.io   (override only for tests)
# LEVER_API_BASE=https://api.lever.co
